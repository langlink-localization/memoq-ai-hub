{
  "name": "memoq-ai-hub-app",
  "private": true,
  "version": "1.0.55",
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "author": "LangLink Localization",
  "description": "memoQ AI Hub Electron application with local gateway and operator console.",
  "main": ".vite/build/main.cjs",
  "files": [
    ".vite/**/*",
    "helper/**/*",
    "package.json"
  ],
  "scripts": {
    "start": "electron-forge start",
    "start:server": "node src/serverStandalone.js",
    "smoke:health": "node src/smokeHealthCheck.js",
    "test": "node --test \"test/*.test.js\" \"test/*.test.mjs\"",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:squirrel": "electron-forge make --platform win32 --targets @electron-forge/maker-squirrel",
    "zip:win-unpacked": "powershell -ExecutionPolicy Bypass -File ..\\..\\tooling\\build\\zip-win-unpacked.ps1"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@langlink-tech/antd-kit": "file:vendor/langlink-tech-antd-kit-0.10.1-4ef8b10.tgz",
    "antd": "6.6.2",
    "body-parser": "1.20.6",
    "dayjs": "^1.11.20",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.7.0",
    "openai": "^6.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sql.js": "^1.13.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/fuses": "^2.1.3",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "^9.2.1",
    "electron": "44.4.5",
    "react-test-renderer": "19.2.4",
    "vite": "8.2.0"
  }
}
