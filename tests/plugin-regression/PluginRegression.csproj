<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <MemoQSdkDir Condition="'$(MemoQSdkDir)' == '' and '$(MEMOQ_SDK_DIR)' != ''">$(MEMOQ_SDK_DIR)</MemoQSdkDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\native\plugin\MemoQ.AI.Desktop.Plugin\MemoQ.AI.Desktop.Plugin.csproj" />
    <Reference Include="MemoQ.Addins.Common">
      <HintPath>$(MemoQSdkDir)\MemoQ.Addins.Common.dll</HintPath>
    </Reference>
    <Reference Include="MemoQ.MTInterfaces">
      <HintPath>$(MemoQSdkDir)\MemoQ.MTInterfaces.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <Target Name="ValidateMemoQSdkReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(MemoQSdkDir)' == ''" Text="MemoQSdkDir is required. Use tooling/scripts/test-plugin-regression.ps1 or set MEMOQ_SDK_DIR." />
    <Error Condition="!Exists('$(MemoQSdkDir)\MemoQ.Addins.Common.dll')" Text="MemoQ.Addins.Common.dll was not found under MemoQSdkDir: $(MemoQSdkDir)" />
    <Error Condition="!Exists('$(MemoQSdkDir)\MemoQ.MTInterfaces.dll')" Text="MemoQ.MTInterfaces.dll was not found under MemoQSdkDir: $(MemoQSdkDir)" />
  </Target>

</Project>
